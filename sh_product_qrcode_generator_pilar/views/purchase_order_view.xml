<odoo>
    <record id="view_purchase_order_form_inherit_qr" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.qrcode</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <!-- <group string="QR Code Info" col="2"> -->
                    <field name="sh_qr_code"/>
                    <field name="sh_qr_code_img" widget="image" class="oe_avatar" nolabel="1"/>
                <!-- </group> -->
            </xpath>
            

        </field>
    </record>
