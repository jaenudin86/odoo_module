<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <!-- Override product card to show variant info clearly -->
    <t t-name="pos_direct_variant.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="replace">
            <div class="product-name">
                <t t-esc="props.product.display_name"/>
            </div>
        </xpath>
    </t>

</templates>