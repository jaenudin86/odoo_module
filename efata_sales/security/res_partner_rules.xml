<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule untuk user biasa, admin tidak kena -->
        <record id="res_partner_user_visibility_rule" model="ir.rule">
            <field name="name">Partner: visible only to assigned user</field>
            <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">
            ['&amp;', ('customer', '=', True), '|', ('users_visible', '=', user.id), ('users_visible', '=', False)]
        </field>


            <!-- Hanya diterapkan untuk user biasa, tidak termasuk admin -->
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
