<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_partner_form_inherit_user_visible" model="ir.ui.view">
    <field name="name">res.partner.form.user.visible</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <xpath expr="//notebook" position="inside">
        <page string="Visible Users">
          <group>
            <field name="users_visible_ids" widget="many2many_tags" options="{'no_create': True}" string="Users"/>
          </group>
        </page>
      </xpath>

    </field>


</record>
</odoo>
