<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Mengubah label tombol Confirm menjadi Confirm SO -->
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="string">Confirm SO</attribute>
            </xpath>
            <!-- Menambahkan tombol Sample -->
            <xpath expr="//header" position="inside">
                <button name="action_sample" type="object" string="Send Sample" class="oe_highlight"
                    invisible="state == 'sale' or state == 'sample_sent' or report_type != 'quotation'" />
            </xpath>
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button name="action_save" type="object" string="Saved" class="oe_highlight"
                    invisible="state == 'sale' or state == 'save'" />
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="replace">
                <button name="action_cancel" type="object" string="Cancel"
                    invisible="state not in ['draft', 'sent', 'sale','sample_sent','save'] or not id or locked"
                    data-hotkey="x" />
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="replace">
                <button name="action_confirm" type="object" string="Confirm"
                    invisible="state not in ['draft', 'sent','save'] or not id or locked"
                    data-hotkey="c" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="report_type" widget="radio" />
                <field name="incl_tax" />
            </xpath>
            <xpath expr="//field[@name='incl_tax']" position="after">
                <field name="color" string="Color Mark" widget="radio" />
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="project"  />
            </xpath>

            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='price_unit']" position="before">
                <field name="tax_amount" string="Tax Amount"
                    attrs="{'column_invisible': [('order_id.incl_tax', '=', true)]}" />
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="tax_amount" string="Tax Amount" optional="show" />
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='tax_id']" position="after">
                <field name="notes" string="Notes" />
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='notes']" position="after">
                <field name="target" string="Target Of" />
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="after">
                <field name="notes" string="Notes" optional="show" />
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='notes']" position="after">
                <field name="target" string="Target Of" optional="show" />
            </xpath>
            <!-- <xpath expr="//field[@name='order_line']/form/group/group/field[@name='product_id']" position="attributes">
            <attribute name="widget">many2one</attribute>
            <attribute name="context">{'show_display_name': True}</attribute>
            </xpath> -->








            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,sale,sample_sent,approved,save</attribute>
            </xpath>

        </field>
    </record>
<!-- <odoo> -->


<record id="view_order_list_inherit" model="ir.ui.view">
    <field name="name">sale.order.list.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree"/>  <!-- Gunakan jika benar ada -->
    <field name="arch" type="xml">
        <xpath expr="//field[@name='name']" position="after">
            <field name="type_transaksi"/>
        </xpath>
        <xpath expr="//field[@name='type_transaksi']" position="after">
            <field name="report_type"/>
              <field name="color"/>
        </xpath>
        <xpath expr="//list" position="attributes">
            <attribute name="decoration-info">color == 'blue'</attribute>
            <attribute name="decoration-danger">color == 'red'</attribute>
            <attribute name="decoration-success">color == 'green'</attribute>
            <attribute name="decoration-warning">color == 'yellow'</attribute>
        </xpath>
    </field>
</record>
<record id="view_order_listview_inherit" model="ir.ui.view">
    <field name="name">sale.order.listview.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree"/>  <!-- Gunakan jika benar ada -->
    <field name="arch" type="xml">
        <xpath expr="//field[@name='name']" position="after">
            <field name="type_transaksi"/>
        </xpath>
        <xpath expr="//field[@name='type_transaksi']" position="after">
            <field name="report_type"/>
            <field name="color"/>

        </xpath>
        <xpath expr="//list" position="attributes">
            <attribute name="decoration-info">color == 'blue'</attribute>
            <attribute name="decoration-danger">color == 'red'</attribute>
            <attribute name="decoration-success">color == 'green'</attribute>
            <attribute name="decoration-warning">color == 'yellow'</attribute>
        </xpath>

    </field>
</record>
<record id="inherit_sale_order_search_view" model="ir.ui.view">
    <field name="name">sale.order.search.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter"/>
    <field name="arch" type="xml">
        <xpath expr="//search" position="inside">
            <!-- Tambahkan filter berdasarkan warna -->
            <filter string="White" name="filter_white" domain="[('color', '=', 'white')]"/>
            <filter string="Blue" name="filter_blue" domain="[('color', '=', 'blue')]"/>
            <filter string="Red" name="filter_red" domain="[('color', '=', 'red')]"/>
            <filter string="Green" name="filter_green" domain="[('color', '=', 'green')]"/>
            <filter string="Yellow" name="filter_yellow" domain="[('color', '=', 'yellow')]"/>

            <!-- Tambahkan Group By berdasarkan Warna -->
            <separator/>
            <filter string="Group by Color" name="group_by_color" context="{'group_by': 'color'}"/>
        </xpath>
    </field>
</record>



