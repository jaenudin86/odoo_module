<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="name">New Name Here</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale.report_saleorder</field>
        <field name="report_file">sale.report_saleorder</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'New Quotation name - %s' % (object.name)) or 'New Order Name - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>