<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_price_quotation_inherit" inherit_id="sale.report_saleorder">
        <xpath expr="//t[@t-call='sale.report_saleorder_raw']" position="replace">
            <t t-call="efata_sales.report_price_quotation" />
        </xpath>
    </template>

    <template id="report_price_quotation">
        <t t-call="web.external_layout">
        <t t-set="doc_name" t-value="'SalesOrder_' + docs.name + '_' + (docs.report_type or 'Report') + '_' + (docs.color or '')"/>
        <t t-set="report_name" t-value="doc_name"/>
            <main>
                <!-- <span>
                    <h3>Quotation #</h3>
                </span> -->
                <!-- <span t-esc="docs.name" /> -->

                <div class="page">
                    <div style="text-align: left; float: left; width: 33%;">
                        <strong>Tanggal:</strong>
                        <span t-esc="docs.date_order.strftime('%d/%m/%Y')" />
                         <strong></strong><br/><br/>
                        <strong t-esc="docs.name" />
                    </div>
                    <div style="text-align: left; float: right; width: 33%;">
                        <strong>Kepada:</strong> <span t-esc="docs.partner_id.name" /><br /><br/>
                        <strong>Project:</strong> <span t-esc="docs.project" /><br />
                    </div>


                    <div style="text-align: center; font-size: 20px; float: left; width: 33%; margin-top: +60px;">

                        <t t-if="docs.report_type == 'quotation'">
                            <strong>PRICE QUOTATION</strong>
                        </t>
                        <t t-elif="docs.report_type == 'submission'">

                            <strong>SUBMISSION</strong>
                        </t>
                    </div>
                    
                    <br /><br />
                    <br /><br />
                    <!-- <t t-if="docs.report_type == 'quotation'"> -->
                        Dear <span t-esc="docs.partner_id.name" />,<br />
                        
                        <t t-if="docs.report_type == 'quotation'">
                            Bersamaan ini kami menyapampaikan  penawaran harga sebagai berikut:
                        </t>
                        <t t-if="docs.report_type == 'submission'">
                             Bersamaan ini kami menyapampaikan sample sebagai berikut:
                        </t>
                    <!-- </t> -->
                    <table class="table table-bordered" style="width:100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #EEE;">
                                <th>Kode</th>
                                <th>Nama Product</th>
                                
                                <t t-if="docs.report_type == 'quotation'">
                                     <th>Packing</th>
                                    <t t-if="docs.incl_tax">
                                        <th>USD/Kg</th>
                                    </t>
                                    <t t-else="">
                                        <th>USD/Kg excl VAT</th>
                                    </t>
                                </t>
                                <t t-if="docs.report_type != 'quotation'">
                                     <th>Notes</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs.order_line" t-as="line">
                                <tr>
                                    <td>
                                        <strong t-esc="line.name"  /><br />
                                        <em>Comment:</em>
                                    </td>
                                    <td>
                                        <strong t-esc="line.product_id.reference2" /><br />
                                        <em>
                                            <t t-if="line.product_properties_dict">
                                                <t t-esc="json.loads(line.product_properties_dict).get('Trend', '')" />
                                            </t>

                                        </em>

                                    </td>
                                    <t t-if="docs.report_type != 'quotation'">
                                         <td><strong t-esc="line.notes" /></td>
                                    </t>
                                    <t t-if="docs.report_type == 'quotation'">
                                       <td><strong t-esc="line.product_packaging_id.name" /></td>
                                        <t t-if="docs.incl_tax">
                                            <td><strong t-esc="'{:.2f}'.format(line.price_unit + line.tax_amount)" /></td>
                                        </t>
                                        <t t-else="">
                                            <td><strong t-esc="line.price_unit" /></td>
                                        </t>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <br />
                    <t t-if="docs.report_type == 'quotation'">
                        <t t-if="docs.note">
                            <span t-field="docs.note"
                                t-attf-style="#{'text-align:justify;text-justify:inter-word;' if docs.company_id.terms_type != 'html' else ''}"
                                name="order_note" />
                        </t>
                        <t t-else="">

                            <div style="width:100%; display: flex; justify-content: space-between; flex-direction: row;">
                                <div style="display: flex; width: 30%;">
                                    <div style="width: 40%;"><strong>MOQ</strong></div>
                                    <div>:</div>
                                    <div>Sesuai Packing</div>
                                </div>
                                <div style="display: flex; width: 30%;">
                                    <div style="width: 40%;"><strong>Pengiriman</strong></div>
                                    <div>:</div>
                                    <div>30 - 60 Hari dari PO diterima</div>
                                </div>
                                <div style="display: flex; width: 30%;">
                                    <div style="width: 40%;"><strong>Pembayaran</strong></div>
                                    <div>:</div>
                                    <div><span t-esc="docs.payment_term_id.name" /></div>
                                </div>
                            </div>
                            <br />
                            <div>
                                Demikian surat penawaran ini kami sampaikan dan kami nantikan konfirmasi dari ibu/Bapak<br /><br />
                                Terima kasih untuk kerjasamanya.
                            </div>
                        </t>
                    </t>
                    <br />
                    <t t-if="docs.report_type == 'quotation'">
                    <div>
                        <span>Hormat Kami,</span><br /><br /><br /><br />
                        <strong t-esc="docs.user_id.name" />
                    </div>
                      </t>
                    
                    <t t-if="docs.report_type != 'quotation'">


                            <div>
                                Demikian surat  ini kami sampaikan dan kami nantikan konfirmasi dari ibu/Bapak<br /><br />
                                Terima kasih untuk kerjasamanya.
                            </div>
                            <t t-if="docs.note">
                            <span t-field="docs.note"
                                t-attf-style="#{'text-align:justify;text-justify:inter-word;' if docs.company_id.terms_type != 'html' else ''}"
                                name="order_note" />
                            </t>
                            <t t-else="">
                            </t>
                    </t>
                    <br />
                    <t t-if="docs.report_type != 'quotation'">
                    <div>
                        <span>Hormat Kami,</span><br /><br /><br /><br />
                        <strong t-esc="docs.user_id.name" />
                    </div>
                      </t>
                </div>
            </main>
        </t>
    </template>
</odoo>
