<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_report_list_inherit" model="ir.ui.view">
        <field name="name">stock.report.list.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="replace">
                <field name="combined_name" string="Product"/>
            </xpath>
        </field>
    </record>
    <record id="view_sales_analysis_report_inherit" model="ir.ui.view">
        <field name="name">sale.report.search.inherit</field>
        <field name="model">sale.report</field>  <!-- Sesuaikan dengan model laporan -->
        <field name="inherit_id" ref="sale.view_order_product_search"/>  <!-- Sesuaikan dengan XML ID yang benar -->
        <field name="arch" type="xml">
            <!-- Ganti product_id dengan combined_name -->
            <xpath expr="//field[@name='product_id']" position="replace">
                <field name="combined_name" string="Product"/>
            </xpath>

            <xpath expr="//filter[@name='product_id']" position="replace">
                <filter string="Product" name="combined_name" context="{'group_by':'combined_name'}"/>
            </xpath>
        </field>
    </record>
</odoo>

