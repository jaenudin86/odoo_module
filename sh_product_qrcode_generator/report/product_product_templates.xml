                    <table style="width:100%; height:100%; border-collapse:collapse; border:1px solid #000; font-size:9px;">
                        <tr>
                            <!-- Logo + QR -->
                            <td style="width:20%; text-align:center; vertical-align:middle; border-right:1px solid #000;">
                                <img src="/sh_product_qrcode_generator/static/logopuco.png" style="width:100px;"/>
                                <!-- <t t-if="product.sh_qr_code">
                                    <div style="margin-top:4px;">
                                        <img t-att-src="'/report/barcode/?type=QR&amp;value=' + str(product.sh_qr_code) + '&amp;width=50&amp;height=50'"
     style="width:50px; height:50px;"/>
                                    </div>
                                </t> -->
                                <t t-if="product.sh_qr_code">
                            <div t-out="product.sh_qr_code" style="padding:0"
                                t-options="{'widget': 'barcode', 'symbology': 'QR', 'img_style': barcode_size}" />
                            <!-- <span class="text-center" t-out="product.sh_qr_code" /> -->
                            </t>
                                <!-- <div style="font-size:12px; margin-top:4px;">Scan Qr</div> -->
                            </td>

                            <!-- Data Field -->
                            <td style="width:80%; vertical-align:top; padding:2px;">
                                <!-- Header Hijau -->
                                <div style="background-color:#9bbb59; text-align:center; font-weight:bold; color:#000; font-size:12px; padding:2px;">
                                    BAP CONTROL
                                </div>
                                <table style="width:100%; margin-top:2px; border-collapse:collapse;">
                                    <tr>
                                        <td style="width:25%;">Product Name</td>
                                        <td style="width:3%;">:</td>
                                        <td><span t-field="product.name"/></td>
                                    </tr>
                                    <tr>
                                        <td>S/N#</td>
                                        <td>:</td>
                                        <!-- <td><span t-field="product.serial_no"/></td> -->
                                    </tr>
                                    <tr>
                                        <td>Part#</td>
                                        <td>:</td>
                                        <td><span t-field="product.default_code"/></td>
                                    </tr>
                                                                        <tr>
                                        <td>IR#</td>
                                        <td>:</td>
                                        <td><span/></td>
                                    </tr>
                                    <tr>
                                        <td>Category</td>
                                        <td>:</td>
                                        <td><span t-field="product.categ_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td>Location</td>
                                        <td>:</td>
                                        <td><span t-field="product.location_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td>WHS Address</td>
                                        <td>:</td>
                                        <td><span t-field="product.warehouse_id.name"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </template>

        <template id="sh_report_productlabel_dymo_with_qr">
            <t t-call="web.html_container">
                <t t-set="barcode_size" t-value="'width:15.5mm;height:15.5mm'" />
                <t t-set="table_style" t-value="'width:100%;height:32mm;'" />
                <t t-set="padding_page" t-value="'padding: 2mm'" />
                <t t-foreach="quantity.items()" t-as="qr_code_and_qty_by_product">
                    <t t-set="product" t-value="qr_code_and_qty_by_product[0]" />
                    <t t-foreach="qr_code_and_qty_by_product[1]" t-as="qr_code_and_qty">
                        <t t-foreach="range(qr_code_and_qty[1])" t-as="qty">
                            <t t-call="sh_product_qrcode_generator.sh_report_simple_label_dymo" />
                        </t>
                    </t>
                </t>
            </t>
        </template>
        <template id="report_bap_control_label_2x7">
            <t t-call="web.html_container">
                <t t-set="barcode_size" t-value="'width:20mm;height:20mm'" />

                <!-- SETTING UKURAN A4 DAN GRID LABEL -->
                <div class="o_label_sheet"
                     style="width:210mm; height:297mm; margin:0 auto; padding:6mm 0 0 6mm; display:flex; flex-wrap:wrap;">

                    <!-- LOOP PRODUK -->
          <t t-foreach="docs" t-as="product">
    <t t-foreach="range(int(product.print_qty or 1))" t-as="i">
        <div class="o_label"
             style="width:97mm; height:37mm; border:1px solid #000; margin:2mm; box-sizing:border-box; display:flex;">
             
            <!-- KIRI: LOGO + QR -->
            <div style="width:35mm; text-align:center; padding-top:2mm; border-right:1px solid #000;">
                <img src="/sni/static/src/img/logo.png"
                     style="width:30mm; margin-bottom:2mm;" alt="Logo"/>
                <t t-if="product.sh_qr_code">
                    <div t-out="product.sh_qr_code"
                         t-options="{'widget': 'barcode', 'symbology': 'QR', 'img_style': barcode_size}" />
                </t>
                <div style="font-size:8px; margin-top:1mm;">Scan QR</div>
            </div>

            <!-- KANAN: DETAIL PRODUK -->
            <div style="flex:1; padding:2mm;">
                <div style="background-color:#A5D6A7; text-align:center; font-weight:bold;
                            font-size:12px; padding:1mm 0; margin-bottom:2mm;">
                    BAP CONTROL
                </div>

                <table style="width:100%; font-size:9px; line-height:1.1;">
                    <tr><td style="width:28%;">Product Name</td><td>:</td><td><span t-field="product.display_name"/></td></tr>
                    <tr><td>S/N#</td><td>:</td><td><span t-field="product.serial_no"/></td></tr>
                    <tr><td>Part#</td><td>:</td><td><span t-field="product.default_code"/></td></tr>
                    <tr><td>IRt#</td><td>:</td><td><span t-field="product.default_code"/></td></tr>
                    <tr><td>Category</td><td>:</td><td><span t-field="product.categ_id.name"/></td></tr>
                    <tr><td>Locaction</td><td>:</td><td><span t-field="product.location_id.name"/></td></tr>
                    <tr><td>WHS Address</td><td>:</td><td><span t-field="product.property_stock_inventory.name"/></td></tr>
                </table>
            </div>
        </div>
    </t>
</t>

                </div>
            </t>
        </template>
    </data>
</odoo>
