<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format -->
    <record id="1paperformat_picking_dymo_label" model="report.paperformat">
        <field name="name">Dymo Label Picking 100x150mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">150</field>
        <field name="page_width">100</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">95</field>
    </record>
    
    <record id="2paperformat_picking_dymo_label_sedang" model="report.paperformat">
        <field name="name">Dymo Label Picking 100x50mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="orientation">Landscape</field>
        <field name="page_height">100</field>
        <field name="page_width">50</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>    
        <field name="header_spacing">0</field>
        <field name="dpi">95</field>
    </record>
    
    <record id="3paperformat_picking_dymo_label_kecil" model="report.paperformat">
        <field name="name">Dymo Label Picking 80x50mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">80</field>
        <field name="page_width">50</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">95</field>
    </record>

    <!-- Report Definition -->
    <record id="action_report_picking_receipt_dymo" model="ir.actions.report">
        <field name="name">Picking Receipt - Besar</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_product_qrcode_generator.1report_picking_receipt_dymo</field>
        <field name="report_file">sh_product_qrcode_generator.1report_picking_receipt_dymo</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="1paperformat_picking_dymo_label"/>
    </record>
    
    <record id="action_report_picking_receipt_dymo_sedang" model="ir.actions.report">
        <field name="name">Picking Receipt - Sedang</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_product_qrcode_generator.2report_picking_receipt_dymo</field>
        <field name="report_file">sh_product_qrcode_generator.2report_picking_receipt_dymo</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="2paperformat_picking_dymo_label_sedang"/>
    </record>
    
    <record id="action_report_picking_receipt_dymo_kecil" model="ir.actions.report">
        <field name="name">Picking Receipt - Kecil</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_product_qrcode_generator.3report_picking_receipt_dymo</field>
        <field name="report_file">sh_product_qrcode_generator.3report_picking_receipt_dymo</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="3paperformat_picking_dymo_label_kecil"/>
    </record>

    <!-- Main Report Templates -->
    <template id="1report_picking_receipt_dymo">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="picking">
                <t t-foreach="picking.move_line_ids_without_package" t-as="move_line">
                    <t t-if="move_line.quantity > 0">
                        <t t-foreach="range(int(move_line.quantity))" t-as="qty_index">
                            <div class="page">
                                <t t-call="sh_product_qrcode_generator.1picking_receipt_label_dymo">
                                    <t t-set="picking" t-value="picking"/>
                                    <t t-set="move_line" t-value="move_line"/>
                                    <t t-set="product" t-value="move_line.product_id"/>
                                </t>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </t>
    </template>
    
    <template id="2report_picking_receipt_dymo">
