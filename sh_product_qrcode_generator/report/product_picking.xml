    <!-- TEMPLATE UNTUK UKURAN BESAR (178x116mm) - QR CENTER & ARIAL FONT -->
    <template id="1picking_receipt_label_dymo">
        <t t-call="web.html_container">
            <div class="o_label_sheet" style="width:178mm; height:116mm; margin:0; padding:0; box-sizing:border-box; font-family:Arial, sans-serif;">
                <table style="width:100%; height:100%; border-collapse:collapse; border:2px solid #000; page-break-inside:avoid; font-family:Arial, sans-serif;">
                    <tr>
                        <td style="vertical-align:top; padding:8px;">
                            <!-- Header -->
                            <div style="text-align:center; font-weight:bold; color:#000; font-size:20px; padding:4px; margin-bottom:8px; border-bottom:2px solid #000; font-family:Arial, sans-serif;">
                                BAP CONTROLS
                            </div>
                            
                            <table style="width:100%; border-collapse:collapse; font-family:Arial, sans-serif;">
                                <tr>
                                    <!-- BAGIAN QR CODE DENGAN LOGO - CENTER VERTICAL -->
                                    <td style="width:30%; text-align:center; vertical-align:middle; padding-right:10px;">
                                        <div style="display:flex; align-items:center; justify-content:center; height:100%;">
                                            <!-- Prioritas 1: Gunakan QR dengan logo -->
                                            <t t-if="product.sh_qr_code_with_logo">
                                                <img t-att-src="'data:image/png;base64,%s' % product.sh_qr_code_with_logo.decode('utf-8')" 
                                                     style="width:140px; height:140px; display:block;"/>
                                            </t>
                                            <!-- Prioritas 2: Fallback ke QR biasa jika logo gagal -->
                                            <t t-elif="product.sh_qr_code">
                                                <div t-out="product.sh_qr_code"
                                                     t-options="{'widget': 'barcode', 'symbology': 'QR', 'img_style': 'width:140px;height:140px;'}"/>
                                            </t>
                                            <!-- Jika tidak ada QR sama sekali -->
                                            <t t-else="">
                                                <div style="width:140px; height:140px; border:2px dashed #ccc; display:flex; align-items:center; justify-content:center;">
                                                    <span style="color:#999; font-size:12px;">No QR Code</span>
                                                </div>
                                            </t>
                                        </div>
                                    </td>
                                    
                                    <!-- Data Fields - ARIAL FONT -->
                                    <td style="width:70%; vertical-align:top; font-size:16px; line-height:1.8; font-family:Arial, sans-serif;">
                                        <table style="width:100%; border-collapse:collapse; font-family:Arial, sans-serif;">
                                            <tr>
                                                <td style="width:30%; font-weight:800;">Product Name</td>
                                               <td style="width:3%; font-weight:600;">:</td>
                                                <td style="font-weight:700;"><span t-esc="product.display_name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:700;">S/N#</td>
                                               <td style="font-weight:600;">:</td>
                                                <td style="font-weight:700;"><span t-esc="move_line.lot_id.name or move_line.lot_name or '-'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:700;">Part#</td>
                                                <td style="font-weight:600;">:</td>
                                                <td style="font-weight:700;"><span t-esc="product.default_code or '-'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:700;">IR#</td>
                                                  <td style="font-weight:600;">:</td>
                                                <td style="font-weight:700;"><span t-esc="picking.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:700;">Category</td>
                                                  <td style="font-weight:600;">:</td>
                                                <td style="font-weight:700;"><span t-esc="product.categ_id.name or '-'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:700;">Location</td>
                                                 <td style="font-weight:600;">:</td>
                                                <td style="font-weight:700;"><span t-esc="picking.picking_type_id.warehouse_id.name or '-'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:700;">WHS Address</td>
                                                   <td style="font-weight:600;">:</td>
                                                <td style="font-weight:700;"><span t-esc="picking.picking_type_id.warehouse_id.partner_id.contact_address or '-'"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

