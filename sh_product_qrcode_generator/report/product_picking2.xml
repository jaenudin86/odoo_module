    <!-- Label Template BESAR (155mm x 116mm) -->
    <template id="1picking_receipt_label_dymo">
        <t t-call="web.html_container">
            <div class="o_label_sheet" style="width:155mm; height:116mm; margin:0; padding:0; box-sizing:border-box;">
                <table style="width:100%; height:100%; border-collapse:collapse; border:2px solid #000; page-break-inside:avoid; margin-bottom:0px;">
                    <tr>
                        <td style="vertical-align:top; padding:8px;">
                            <!-- Header -->
                            <div style="text-align:center; font-weight:bold; color:#000; font-size:20px; padding:4px; margin-bottom:8px; border-bottom:2px solid #000;">
                                BAP CONTROLS
                            </div>
                            
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <!-- QR Code dengan Logo di tengah -->
                                    <td style="width:35%; text-align:center; vertical-align:top; padding-right:10px;">
                                        <div style="position:relative; display:inline-block;">
                                            <t t-if="product.sh_qr_code">
                                                <div t-out="product.sh_qr_code"
                                                    t-options="{'widget': 'barcode', 'symbology': 'QR', 'img_style': 'width:140px;height:140px;'}"/>
                                            </t>
                                            <!-- Logo di tengah QR Code -->
                                            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); background:white; padding:3px; border-radius:4px;">
                                                <img src="/sh_product_qrcode_generator/static/logopuco.png" style="width:40px; height:auto;"/>
                                            </div>
                                        </div>
                                    </td>
                                    
                                    <!-- Data Fields -->
                                    <td style="width:65%; vertical-align:top; font-size:15px; line-height:1.8;">
                                        <table style="width:100%; border-collapse:collapse;">
                                            <tr>
                                                <td style="width:30%; font-weight:600;">Product Name</td>
                                                <td style="width:3%;">:</td>
                                                <td style="font-weight:400;"><span t-esc="product.display_name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:600;">S/N#</td>
                                                <td>:</td>
                                                <td style="font-weight:400;"><span t-esc="move_line.lot_id.name or move_line.lot_name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:600;">Part#</td>
                                                <td>:</td>
                                                <td style="font-weight:400;"><span t-esc="product.default_code"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:600;">IR#</td>
                                                <td>:</td>
                                                <td style="font-weight:400;"><span t-esc="picking.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:600;">Category</td>
                                                <td>:</td>
                                                <td style="font-weight:400;"><span t-esc="product.categ_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:600;">Location</td>
                                                <td>:</td>
                                                <td style="font-weight:400;"><span t-esc="picking.picking_type_id.warehouse_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:600;">WHS Address</td>
                                                <td>:</td>
                                                <td style="font-weight:400;"><span t-esc="picking.picking_type_id.warehouse_id.partner_id.contact_address"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

